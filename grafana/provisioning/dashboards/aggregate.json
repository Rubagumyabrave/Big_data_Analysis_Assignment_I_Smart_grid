        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Time|time|period|region|completeness_pct|energy_kwh.*)$"
            }
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Completeness by region (%)",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH registered AS (SELECT region, count(*) AS meters FROM meters GROUP BY region),\n     observed AS (\n        SELECT v.region, sum(v.reading_count) AS reading_count\n        FROM energy_15min_region v\n        WHERE v.bucket >= time_bucket('1 day', $__timeFrom()::timestamptz, 'Africa/Kigali') AND v.bucket < (time_bucket('1 day', $__timeTo()::timestamptz - INTERVAL '1 microsecond', 'Africa/Kigali') + INTERVAL '1 day')\n        GROUP BY v.region)\nSELECT g.region, coalesce(o.reading_count, 0) AS reading_count,\n       g.meters * 96 * (extract(epoch FROM (time_bucket('1 day', $__timeTo()::timestamptz - INTERVAL '1 microsecond', 'Africa/Kigali') + INTERVAL '1 day') - time_bucket('1 day', $__timeFrom()::timestamptz, 'Africa/Kigali')) / 86400) AS planned_readings,\n       100.0 * coalesce(o.reading_count, 0) / (g.meters * 96 * (extract(epoch FROM (time_bucket('1 day', $__timeTo()::timestamptz - INTERVAL '1 microsecond', 'Africa/Kigali') + INTERVAL '1 day') - time_bucket('1 day', $__timeFrom()::timestamptz, 'Africa/Kigali')) / 86400)) AS completeness_pct\nFROM registered g LEFT JOIN observed o USING (region)\nORDER BY substring(region FROM 8)::int"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {},
          "displayName": "${__data.fields.region}",
          "min": 95,
          "max": 100
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Time|time|period|region|completeness_pct|energy_kwh.*)$"
            }
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": ""
        },
        "showUnfilled": true
      }
    }
  ]
