    },
    {
      "id": 3,
      "title": "Network energy per seven-day period from 1 Sep (kWh)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(time_bucket('7 days', v.bucket, TIMESTAMPTZ '2026-09-01 00:00+02'), 'DD Mon') AS period,\n       sum(v.energy_kwh) AS energy_kwh, sum(v.reading_count) AS reading_count\nFROM energy_15min_region v\nWHERE v.bucket >= time_bucket('1 day', $__timeFrom()::timestamptz, 'Africa/Kigali') AND v.bucket < (time_bucket('1 day', $__timeTo()::timestamptz - INTERVAL '1 microsecond', 'Africa/Kigali') + INTERVAL '1 day')\nGROUP BY time_bucket('7 days', v.bucket, TIMESTAMPTZ '2026-09-01 00:00+02')\nORDER BY time_bucket('7 days', v.bucket, TIMESTAMPTZ '2026-09-01 00:00+02')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "custom": {},
          "displayName": "Energy (kWh)"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Time|time|period|region|completeness_pct|energy_kwh.*)$"
            }
          }
        }
      ],
      "options": {
        "xField": "period",
        "orientation": "vertical",
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Daily energy for meter $meter (kWh)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT v.bucket AS time, sum(v.energy_kwh) AS energy_kwh, sum(v.reading_count) AS reading_count\nFROM energy_daily_meter v\nWHERE v.meter_id = $meter AND v.bucket >= time_bucket('1 day', $__timeFrom()::timestamptz, 'Africa/Kigali') AND v.bucket < (time_bucket('1 day', $__timeTo()::timestamptz - INTERVAL '1 microsecond', 'Africa/Kigali') + INTERVAL '1 day')\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
