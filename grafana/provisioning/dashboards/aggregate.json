  "panels": [
    {
      "id": 1,
      "title": "Hourly regional energy (kWh)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT v.bucket AS time, v.region AS metric,\n       sum(v.energy_kwh) AS energy_kwh, sum(v.reading_count) AS reading_count\nFROM energy_hourly_region v\nWHERE v.bucket >= time_bucket('1 day', $__timeFrom()::timestamptz, 'Africa/Kigali') AND v.bucket < (time_bucket('1 day', $__timeTo()::timestamptz - INTERVAL '1 microsecond', 'Africa/Kigali') + INTERVAL '1 day')\nGROUP BY 1, 2 ORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "displayName": "${__field.labels.metric}"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Time|time|period|region|completeness_pct|energy_kwh.*)$"
            }
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Daily network energy (kWh)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 day', v.bucket, 'Africa/Kigali') AS time,\n       sum(v.energy_kwh) AS energy_kwh, sum(v.reading_count) AS reading_count\nFROM energy_15min_region v\nWHERE v.bucket >= time_bucket('1 day', $__timeFrom()::timestamptz, 'Africa/Kigali') AND v.bucket < (time_bucket('1 day', $__timeTo()::timestamptz - INTERVAL '1 microsecond', 'Africa/Kigali') + INTERVAL '1 day')\nGROUP BY 1 ORDER BY 1"
        }
